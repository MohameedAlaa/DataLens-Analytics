# DataLens Analytics — Production Environment Variables Configuration Template
# Copy this file to .env (do not commit .env to version control).

# --- Application Environment ---
# Set to 'production' to enforce strict CORS policies and disable OpenAPI docs (/docs, /redoc)
APP_ENV=production

# --- Storage Engine & Persistence ---
# Use 'disk' for persistent deployments. Point DATASET_STORAGE_DIR to a durable mounted volume.
STORAGE_ENGINE=disk
DATASET_STORAGE_DIR=./dataset_storage

# --- ChromaDB Vector Store ---
# Point CHROMA_PERSIST_DIR to a durable mounted volume for persistent vector embeddings.
CHROMA_PERSIST_DIR=./chroma_db

# --- Security & CORS ---
# In production, provide an explicit, comma-separated list of trusted frontend origins. Wildcard '*' is blocked.
CORS_ORIGINS=https://datalens.yourdomain.com
CORS_ALLOW_CREDENTIALS=false

# --- AI & Gemini Model Integration ---
# Provide your active Google Gemini API key. Keep secret and do not expose.
GOOGLE_API_KEY=your_production_google_gemini_api_key
AI_MODEL=gemini-2.5-flash

# --- Frontend Build URL ---
# For static frontend deployment, pass this environment variable during 'npm run build':
# VITE_API_BASE_URL=https://api.datalens.yourdomain.com

# --- Rate Limiting & Performance ---
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_FILTER=120/minute
RATE_LIMIT_DEFAULT=60/minute
# TRUSTED_PROXIES=10.0.0.1,172.16.0.1
MAX_UPLOAD_MB=50
UPLOAD_PREVIEW_LIMIT=100

# --- Logging ---
LOG_FORMAT=json
LOG_LEVEL=INFO
