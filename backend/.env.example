GOOGLE_API_KEY=your_google_api_key_here
AI_MODEL=gemini-2.5-flash

# --- CORS (comma-separated origins) ---
# For local development. In production, set explicit origins:
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# --- Upload limits ---
MAX_UPLOAD_MB=50
UPLOAD_PREVIEW_LIMIT=100

# --- Rate limiting (slowapi token-bucket format: N/period) ---
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_FILTER=120/minute
RATE_LIMIT_DEFAULT=60/minute

# --- Trusted proxies (comma-separated IPs). Empty by default to reject spoofed X-Forwarded-For ---
# TRUSTED_PROXIES=127.0.0.1

# --- Logging ---
# LOG_FORMAT=json   # use "json" in production, "text" for local dev
LOG_FORMAT=text
LOG_LEVEL=INFO

# --- Environment ---
# APP_ENV=production  # set to "production" to enforce strict CORS and disable /docs, /redoc
APP_ENV=development

# --- Storage Engine (memory | disk) ---
# For production persistent FastAPI deployments, STORAGE_ENGINE must be set to 'disk'
# and DATASET_STORAGE_DIR must point to a persistent mounted volume.
STORAGE_ENGINE=disk
DATASET_STORAGE_DIR=./dataset_storage

# --- Vector Database & RAG ---
# Persistent directory for ChromaDB vector embeddings
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2
DATASET_TTL=86400

